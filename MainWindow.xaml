<Window x:Class="SearchApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Asszisztens" Height="400" Width="700" 
        WindowStyle="None" AllowsTransparency="True" 
        Icon="appicon.ico"
        Background="Transparent" Topmost="True"
        WindowStartupLocation="Manual">

    <Window.Resources>
        <Style TargetType="RadioButton" x:Key="FilterChip">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#888888"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15" Padding="{TemplateBinding Padding}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#2200E5FF"/>
                                <Setter Property="Foreground" Value="#00E5FF"/>
                                <Setter Property="BorderBrush" Value="#00E5FF"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#11FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ListBoxItem" x:Key="ResultItemStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="15,10"/>
            <Setter Property="Margin" Value="5,2"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#2200E5FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid Width="44" Height="44" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,15,0,0">
            <Grid.Triggers>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="600" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Height" To="95" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SearchContent" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.25" BeginTime="0:0:0.1"/>
                            <ColorAnimation Storyboard.TargetName="SearchIconBrush" Storyboard.TargetProperty="Color" To="#00E5FF" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Width" To="44" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetProperty="Height" To="44" Duration="0:0:0.35"><DoubleAnimation.EasingFunction><QuarticEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            <DoubleAnimation Storyboard.TargetName="SearchContent" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.15"/>
                            <ColorAnimation Storyboard.TargetName="SearchIconBrush" Storyboard.TargetProperty="Color" To="#888888" Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Grid.Triggers>

            <Border CornerRadius="22" Background="#1E1E20">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="25" ShadowDepth="10" Opacity="0.5" Color="Black" />
                </Border.Effect>
            </Border>

            <Border CornerRadius="22" ClipToBounds="True" BorderThickness="1" BorderBrush="#33FFFFFF">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#2A2A2D" Offset="0.0" />
                        <GradientStop Color="#1A1A1C" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="44"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <TextBlock Grid.Column="0" Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Foreground>
                                <SolidColorBrush x:Name="SearchIconBrush" Color="#888888"/>
                            </TextBlock.Foreground>
                        </TextBlock>
                        
                        <Grid Grid.Column="1" x:Name="SearchContent" Opacity="0" Margin="5,0,20,0">
                            <TextBlock x:Name="SearchPlaceholder" Text="Keresés, programok, vagy kérdezz tőlem (Gemini)..." Foreground="#66FFFFFF" FontSize="16" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            
                            <TextBox x:Name="SearchInput" KeyDown="SearchInput_KeyDown" TextChanged="SearchInput_TextChanged" Background="Transparent" BorderThickness="0" FontSize="16" VerticalAlignment="Center" Foreground="#FFFFFF" FontFamily="Segoe UI Variable, Segoe UI" CaretBrush="#00E5FF"/>
                        </Grid>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="44,5,0,15">
                        <RadioButton x:Name="FilterAll" Style="{StaticResource FilterChip}" Content="🌍 Minden" IsChecked="True"/>
                        <RadioButton x:Name="FilterFiles" Style="{StaticResource FilterChip}" Content="📁 Fájlok"/>
                        <RadioButton x:Name="FilterWeb" Style="{StaticResource FilterChip}" Content="🌐 Web"/>
                        <RadioButton x:Name="FilterAI" Style="{StaticResource FilterChip}" Content="✨ Gemini AI" FontWeight="Bold"/>
                    </StackPanel>

                    <!-- EBBEN A BLOKKBAN KERÜLT BE A SELECTIONCHANGED ÉS AZ IMAGE TAG -->
                    <ListBox x:Name="SearchResultsList" Grid.Row="2" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ItemContainerStyle="{StaticResource ResultItemStyle}" Visibility="Collapsed" Margin="0,0,0,10" SelectionChanged="SearchResultsList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <!-- A csúnya emoji helyett ez beköti az igazi ikont -->
                                    <Image Grid.Column="0" Source="{Binding Icon}" Width="24" Height="24" Margin="0,0,15,0" Stretch="Uniform"/>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="#888888" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- IDE KERÜLT BE A GEMINI VÁLASZ DOBOZA (A ListBox alá) -->
                    <ScrollViewer x:Name="AiResponseScroll" Grid.Row="2" Visibility="Collapsed" Margin="10,0,10,10">
                        <TextBlock x:Name="AiResponseText" TextWrapping="Wrap" Foreground="White" FontSize="15" Margin="5"/>
                    </ScrollViewer>

                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>